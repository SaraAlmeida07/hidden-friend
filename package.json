{
  "name": "hidden-friend",
  "version": "1.0.0",
  "description": "Monorepo do projeto da disciplina",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{ts,js,json,css,scss,md}\"",
    "dev:api": "json-server --watch apps/api/db.json --port 3000",
    "dev:web": "npm run start -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test:web": "npm run test -w apps/web"
  },
  "keywords": [
    "angular",
    "supabase",
    "monorepo"
  ],
  "author": "Matheus Popolin e Sara Pereira de Almeida",
  "license": "UNLICENSED",
  "devDependencies": {
    "json-server": "^0.17.4",
    "prettier": "^3.8.3"
  }
}
